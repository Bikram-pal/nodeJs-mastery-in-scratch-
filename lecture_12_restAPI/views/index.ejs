<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>home page</title>
  <link rel="stylesheet" href="index.css">
</head>
<body>
  <h1>Quora posts</h1>
  <% for(post of posts){ %>
    <div>
      <p>id: <%= post.id %></p>
      <h2>@<%= post.username %></h2>
      <h3><%= post.content %></h3>
    </div>
 <%}%>

 <h1>add new post</h1>
  <a href="/posts/new">
    <button>New Post</button>
  </a>
</body>
</html>